#!/bin/sh

# PARA-CODE: Keep interactive Codex sessions started from a Para Code terminal off Codex's
# shared background server (the daemon). Non-interactive commands are delegated unchanged to
# the user's Codex executable.
#
# This launcher used to start a pane-scoped `codex app-server` and attach the TUI to it with
# `--remote` (the mobile "live" streaming). That mode was removed: Codex rejects permission
# overrides, `--add-dir` and other options with `--remote resume|fork`, and the pane app-server
# restarted every MCP server for each terminal. A PARA_CODE_CODEX_APP_SERVER_SOCKET left in the
# environment of a terminal opened by an older Para Code is ignored.

set -u

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
original_path=${PATH:-}
clean_path=
old_ifs=$IFS
IFS=:
for path_entry in $original_path; do
	if [ "$path_entry" = "$launcher_dir" ]; then
		continue
	fi
	if [ -z "$clean_path" ]; then
		clean_path=$path_entry
	else
		clean_path=$clean_path:$path_entry
	fi
done
IFS=$old_ifs

real_codex=$(PATH=$clean_path command -v codex 2>/dev/null || true)
if [ -z "$real_codex" ] || [ "$real_codex" = "$0" ]; then
	echo "Para Code: Codex executable was not found after the pane launcher." >&2
	exit 127
fi

early_delegate=0
user_no_daemon=0
has_positional=0
first_positional=
skip_next=0
for argument in "$@"; do
	if [ "$skip_next" -eq 1 ]; then
		skip_next=0
		continue
	fi
	case "$argument" in
		--remote|--remote=*|--help|-h|--version|-V)
			early_delegate=1
			break
			;;
		--no-daemon)
			# The user already keeps this session off the shared background server. Codex
			# rejects the flag together with `--remote`, and twice, so run it exactly as typed.
			user_no_daemon=1
			;;
		--)
			# Codex treats everything after `--` as the prompt, never as a subcommand.
			break
			;;
		-c|--config|--enable|--disable|--remote-auth-token-env|-i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|-C|--cd|--add-dir|-a|--ask-for-approval)
			skip_next=1
			;;
		-*)
			;;
		*)
			if [ "$has_positional" -eq 0 ]; then
				first_positional=$argument
				has_positional=1
			fi
			;;
	esac
done

# Only an interactive TUI session (no subcommand at all, a bare prompt, `resume`, or `fork`)
# is kept off the shared background server; every other subcommand is delegated unchanged,
# because `--no-daemon` is a TUI option and some subcommands (`agents`, `queue`) reject it.
# The list is Codex 0.146's full set (including aliases and the internal subcommands that
# `codex --help` hides) minus the two TUI commands, plus `agents`, and the 0.158 additions
# `queue`, `migrate-rollouts` and `tcp-tunnel`. A subcommand missing here gets `--no-daemon`
# and may refuse it; keep the list current (the Windows launcher and the mobile relay's
# command parser carry the same list).
command_kind=unknown
if [ "$early_delegate" -eq 1 ] || [ "$user_no_daemon" -eq 1 ]; then
	command_kind=delegated
elif [ "$has_positional" -eq 0 ]; then
	command_kind=tui
else
	case "$first_positional" in
		resume|fork)
			command_kind=tui
			;;
		exec|e|review|login|logout|mcp|plugin|mcp-server|app-server|remote-control|app|completion|update|doctor|sandbox|debug|apply|a|archive|delete|unarchive|cloud|exec-server|execpolicy|responses-api-proxy|stdio-to-uds|features|help|agents|queue|migrate-rollouts|tcp-tunnel)
			command_kind=delegated
			;;
	esac
fi

if [ "$command_kind" = delegated ]; then
	exec env PATH="$clean_path" "$real_codex" "$@"
fi

# Codex attaches an interactive session to its shared background server (the daemon)
# whenever one is running for this CODEX_HOME, and 0.157 and later also start it on first
# use. Hooks and MCP servers then run in that server with the environment of whichever
# terminal started it, so they report to the wrong pane (or to none), and the server keeps
# that environment after every pane closes. Every interactive session this launcher runs must
# therefore stay embedded:
#  - Codex 0.156 and later: `--no-daemon`. It is the only option that also refuses a server
#    that is already running; `-c features.daemon_auto_start=false` only stops a new one
#    from starting, and Codex still attaches to a running one.
#  - Codex 0.155 and older reject `--no-daemon` and refuse to start, so they get the `-c`
#    override instead. Any `-c` override already keeps those versions off a running server;
#    the key itself only logs an unknown feature there.
# Which one applies is asked from Codex itself (the flag is accepted or it is not), not read
# from a version string. That costs one `--version` run, about 10 ms for the native binary
# and 40 ms behind npm's Node wrapper.
# `codex agents` needs the shared server and rejects `--no-daemon`; it is delegated above.
# Replace this process with the user's Codex, kept off the shared background server.
exec_unmanaged() {
	if PATH=$clean_path "$real_codex" --no-daemon --version </dev/null >/dev/null 2>&1; then
		exec env PATH="$clean_path" "$real_codex" --no-daemon "$@"
	fi
	exec env PATH="$clean_path" "$real_codex" -c features.daemon_auto_start=false "$@"
}

exec_unmanaged "$@"
