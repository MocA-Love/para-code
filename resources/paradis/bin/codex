#!/bin/sh

# PARA-CODE: Start interactive Codex sessions against a pane-scoped app-server so
# MCP servers inherit the terminal pane environment. Non-interactive commands are
# delegated unchanged to the user's Codex executable.
#
# The pane app-server is an enhancement, not a requirement: if it cannot be started
# (a broken Codex state directory, a full disk, a stale runtime directory, …) this
# launcher warns and runs the user's Codex directly rather than failing. Because this
# launcher is injected into every Para Code terminal's PATH unconditionally and there
# is no setting to bypass it, exiting here would leave the user with no way to run
# Codex at all — `resume` is not on the delegated-command list either.

set -u

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
original_path=${PATH:-}
clean_path=
old_ifs=$IFS
IFS=:
for path_entry in $original_path; do
	if [ "$path_entry" = "$launcher_dir" ]; then
		continue
	fi
	if [ -z "$clean_path" ]; then
		clean_path=$path_entry
	else
		clean_path=$clean_path:$path_entry
	fi
done
IFS=$old_ifs

real_codex=$(PATH=$clean_path command -v codex 2>/dev/null || true)
if [ -z "$real_codex" ] || [ "$real_codex" = "$0" ]; then
	echo "Para Code: Codex executable was not found after the pane launcher." >&2
	exit 127
fi

managed=1
skip_next=0
first_positional=1
for argument in "$@"; do
	if [ "$skip_next" -eq 1 ]; then
		skip_next=0
		continue
	fi
	case "$argument" in
		--remote|--remote=*)
			managed=0
			break
			;;
		--)
			break
			;;
		-c|--config|--enable|--disable|--remote-auth-token-env|-i|--image|-m|--model|--local-provider|-p|--profile|-s|--sandbox|-C|--cd|--add-dir|-a|--ask-for-approval)
			skip_next=1
			;;
		--help|-h|--version|-V)
			managed=0
			break
			;;
		-*)
			;;
		exec|review|login|logout|mcp|mcp-server|app-server|completion|cloud|debug|apply|sandbox|features|remote-control)
			if [ "$first_positional" -eq 1 ]; then
				managed=0
				break
			fi
			;;
		*)
			first_positional=0
			;;
	esac
done

if [ "$managed" -eq 0 ]; then
	exec env PATH="$clean_path" "$real_codex" "$@"
fi

# Every path below can fall back to the unmanaged Codex, so the cleanup helper has to be
# callable before the app-server exists. `owns_server` stays 0 until we actually start one,
# which keeps cleanup a no-op for the early validation failures.
socket_path=
pid_path=
owner_path=
log_path=
server_pid=
owns_server=0

cleanup() {
	if [ "$owns_server" -ne 1 ] || [ -z "$server_pid" ]; then
		return
	fi
	current_owner=
	if [ -f "$owner_path" ]; then
		IFS= read -r current_owner < "$owner_path" || current_owner=
	fi
	if [ "$current_owner" = "$$" ]; then
		kill "$server_pid" 2>/dev/null || true
		wait "$server_pid" 2>/dev/null || true
		# `.log` is deliberately kept: it is the only record of why an app-server died, and
		# both the user and Para Code's diagnostics read it after the fact.
		rm -f "$socket_path" "$pid_path" "$owner_path"
	fi
	owns_server=0
}

# Give up on the pane app-server and hand the session to the user's Codex unchanged.
# `exec` does not run the EXIT trap, so release the app-server before replacing the process.
fallback_direct() {
	fallback_reason=$1
	shift
	echo "Para Code: $fallback_reason Starting Codex without the pane app-server; MCP servers will not inherit this pane's environment." >&2
	cleanup
	trap - EXIT
	exec env PATH="$clean_path" "$real_codex" "$@"
}

socket_path=${PARA_CODE_CODEX_APP_SERVER_SOCKET:-}
case "$socket_path" in
	/*/*.sock) ;;
	*)
		fallback_direct "PARA_CODE_CODEX_APP_SERVER_SOCKET is missing or invalid." "$@"
		;;
esac
socket_name=${socket_path##*/}
case "$socket_name" in
	''|*[!A-Za-z0-9._-]*)
		fallback_direct "Codex app-server socket name is invalid." "$@"
		;;
esac

runtime_dir=${socket_path%/*}
case "$runtime_dir" in
	*/pcx) ;;
	*)
		fallback_direct "Codex app-server socket must be inside the Para Code pcx runtime directory." "$@"
		;;
esac
pid_path=$socket_path.pid
owner_path=$socket_path.owner
log_path=$socket_path.log
umask 077
mkdir -p "$runtime_dir" || fallback_direct "could not create the Para Code pcx runtime directory." "$@"
chmod 700 "$runtime_dir" || fallback_direct "could not secure the Para Code pcx runtime directory." "$@"

if [ -f "$pid_path" ]; then
	IFS= read -r server_pid < "$pid_path" || server_pid=
	case "$server_pid" in
		''|*[!0-9]*) server_pid= ;;
	esac
	if [ -n "$server_pid" ] && ! kill -0 "$server_pid" 2>/dev/null; then
		server_pid=
	fi
	if [ -n "$server_pid" ]; then
		server_command=$(ps -p "$server_pid" -o command= 2>/dev/null || true)
		if ! printf '%s\n' "$server_command" | grep -F -- "app-server --listen unix://$socket_path" >/dev/null 2>&1; then
			server_pid=
		fi
	fi
fi

if [ -z "$server_pid" ]; then
	rm -f "$socket_path" "$pid_path" "$owner_path"
	: > "$log_path"
	PATH=$clean_path "$real_codex" app-server --listen "unix://$socket_path" </dev/null >>"$log_path" 2>&1 &
	server_pid=$!
	owns_server=1
	if ! printf '%s\n' "$server_pid" > "$pid_path" || ! printf '%s\n' "$$" > "$owner_path"; then
		kill "$server_pid" 2>/dev/null || true
		wait "$server_pid" 2>/dev/null || true
		rm -f "$socket_path" "$pid_path" "$owner_path"
		# Already released above, so keep cleanup from killing an unrelated recycled pid.
		owns_server=0
		server_pid=
		fallback_direct "could not record pane Codex app-server ownership." "$@"
	fi
else
	owner_pid=
	if [ -f "$owner_path" ]; then
		IFS= read -r owner_pid < "$owner_path" || owner_pid=
		case "$owner_pid" in
			''|*[!0-9]*) owner_pid= ;;
		esac
	fi
	if [ -z "$owner_pid" ] || ! kill -0 "$owner_pid" 2>/dev/null; then
		owns_server=1
		printf '%s\n' "$$" > "$owner_path"
	fi
fi

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

attempt=0
while [ ! -S "$socket_path" ]; do
	if ! kill -0 "$server_pid" 2>/dev/null; then
		fallback_direct "pane Codex app-server failed to start (see $log_path)." "$@"
	fi
	attempt=$((attempt + 1))
	if [ "$attempt" -ge 100 ]; then
		fallback_direct "timed out waiting for pane Codex app-server (see $log_path)." "$@"
	fi
	sleep 0.1
done

PATH=$clean_path "$real_codex" --remote "unix://$socket_path" "$@"
status=$?
exit "$status"
