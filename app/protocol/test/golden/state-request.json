{
	"$comment": "mobile -> PC の state チャネル（State の要求）の固定形。current は今のアプリ、preW217 は W2-17 より前のアプリ（minCompatiblePc / capabilities を送らない）。current の形はアプリの requestState（app/mobile/src/store.ts）と完全に一致させる。",
	"current": {
		"protocolVersion": 4,
		"minCompatiblePc": 4,
		"capabilities": ["state.gzip.v1", "term.sync.v1", "fs.upload-binary.v1", "voice.clips.v1", "voice.stream.v1", "term.viewport.takeback.v1", "agent.approval.options.v1", "agent.history.page.v1", "agent.resume.v1", "browser.focus.v1", "state.unchanged.v1", "agent.workflows.v1", "agent.session-status.v1", "browser.cursor.v1"],
		"stateEncoding": "json-gzip-v1"
	},
	"preW217": {
		"protocolVersion": 3,
		"stateEncoding": "json-gzip-v1"
	}
}
